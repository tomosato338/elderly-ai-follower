<?xml version="1.0" ?>
<sdf version="1.6">

<model name="follower_bot">

  <link name="base_link">
    <!-- zを0.05から0.11に変更し、最初から車輪が地面に着く高さに調整します -->
    <pose>0 0 0.11 0 0 0</pose>

    <inertial>
      <!-- 重心を少し下（z=-0.05）に下げることで、起き上がり小法師のように転倒しにくくします -->
      <pose>0 0 -0.05 0 0 0</pose>
      <mass>5.0</mass>
      <inertia>
        <ixx>0.054</ixx>
        <ixy>0</ixy>
        <ixz>0</ixz>
        <iyy>0.083</iyy>
        <iyz>0</iyz>
        <izz>0.104</izz>
      </inertia>
    </inertial>

    <visual name="body">
      <geometry>
        <box>
          <size>0.4 0.3 0.2</size>
        </box>
      </geometry>
      <material>
        <ambient>1 0 0 1</ambient>
        <diffuse>1 0 0 1</diffuse>
      </material>
    </visual>

    <collision name="body_collision">
      <geometry>
        <box>
          <size>0.4 0.3 0.2</size>
        </box>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>0.0</mu>
            <mu2>0.0</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
  </link>


  <link name="left_wheel">
    <pose>0 0.18 0.05 1.5708 0 0</pose>
    
    <visual name="left_vis">
      <geometry>
        <cylinder>
          <radius>0.05</radius>
          <length>0.03</length>
        </cylinder>
      </geometry>
    </visual>

    <inertial>
      <mass>0.2</mass>
      <inertia>
        <ixx>0.000167</ixx>
        <ixy>0</ixy>
        <ixz>0</ixz>
        <iyy>0.000167</iyy>
        <iyz>0</iyz>
        <izz>0.00025</izz>
      </inertia>
    </inertial>

    <collision name="left_col">
      <geometry>
        <cylinder>
          <radius>0.05</radius>
          <length>0.03</length>
        </cylinder>
      </geometry>
    </collision>
  </link>

  <link name="right_wheel">
    <pose>0 -0.18 0.05 1.5708 0 0</pose>
    
    <visual name="right_vis">
      <geometry>
        <cylinder>
          <radius>0.05</radius>
          <length>0.03</length>
        </cylinder>
      </geometry>
    </visual>

    <inertial>
      <mass>0.2</mass>
      <inertia>
        <ixx>0.000167</ixx>
        <ixy>0</ixy>
        <ixz>0</ixz>
        <iyy>0.000167</iyy>
        <iyz>0</iyz>
        <izz>0.00025</izz>
      </inertia>
    </inertial>
        
    <collision name="right_col">
      <geometry>
        <cylinder>
          <radius>0.05</radius>
          <length>0.03</length>
        </cylinder>
      </geometry>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="revolute">
    <parent>base_link</parent>
    <child>left_wheel</child>
    <axis>
      <xyz>0 1 0</xyz>
    </axis>
  </joint>

  <joint name="right_wheel_joint" type="revolute">
    <parent>base_link</parent>
    <child>right_wheel</child>
    <axis>
      <xyz>0 1 0</xyz>
    </axis>
  </joint>

  <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
    <left_joint>left_wheel_joint</left_joint>
    <right_joint>right_wheel_joint</right_joint>
    <wheel_separation>0.36</wheel_separation>
    <wheel_diameter>0.10</wheel_diameter>
    <topicName>cmd_vel</topicName>
  </plugin>

</model>
</sdf>

