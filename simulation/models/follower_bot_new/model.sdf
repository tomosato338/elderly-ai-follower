<sdf version="1.6">
  <model name="follower_bot_new">
    <static>false</static>
    <self_collide>false</self_collide>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">

     <ros>
      <namespace>/follower_bot_new</namespace>
     </ros>

     <left_joint>left_wheel_joint</left_joint>
     <right_joint>right_wheel_joint</right_joint>

     <wheel_separation>0.30</wheel_separation>
     <wheel_diameter>0.10</wheel_diameter>

     <max_wheel_torque>1.5</max_wheel_torque>
     <max_wheel_acceleration>2.0</max_wheel_acceleration>

     <command_topic>cmd_vel</command_topic>

     <odometry_topic>odom</odometry_topic>
     <odometry_frame>odom</odometry_frame>

     <robot_base_frame>base_link</robot_base_frame>

     <publish_odom>true</publish_odom>
     <publish_odom_tf>false</publish_odom_tf>
     <publish_wheel_tf>true</publish_wheel_tf>

    </plugin>

    <link name="base_link">
      <pose>0 0 0.15 0 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.01127</ixx>
          <iyy>0.02213</iyy>
          <izz>0.0296</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="base_link_collision">
        <geometry>
          <box>
            <size>0.36 0.24 0.10</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="base_link_visual">
        <geometry>
          <box>
            <size>0.36 0.24 0.10</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.45 0.85 1</ambient>
          <diffuse>0.15 0.45 0.85 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="left_wheel">
      <pose>0 0.15 0.05 1.5707963 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <iyy>0.0005</iyy>
          <izz>0.00025</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="left_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>1.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="left_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="right_wheel">
      <pose>0 -0.15 0.05 1.5707963 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <iyy>0.0005</iyy>
          <izz>0.00025</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="right_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>1.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="right_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="front_caster">
      <pose>0.14 0 0.03 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1.8e-05</ixx>
          <iyy>1.8e-05</iyy>
          <izz>1.8e-05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="front_caster_collision">
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.05</mu>
              <mu2>0.05</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="front_caster_visual">
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
      </visual>
    </link>

    <link name="rear_caster">
      <pose>-0.14 0 0.03 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1.8e-05</ixx>
          <iyy>1.8e-05</iyy>
          <izz>1.8e-05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="rear_caster_collision">
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.05</mu>
              <mu2>0.05</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="rear_caster_visual">
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
      </visual>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <pose>0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <use_parent_model_frame>true</use_parent_model_frame>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>2</effort>
          <velocity>20</velocity>
        </limit>
        <dynamics>
          <damping>0.01</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <pose>0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <use_parent_model_frame>true</use_parent_model_frame>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>2</effort>
          <velocity>20</velocity>
        </limit>
        <dynamics>
          <damping>0.01</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="front_caster_joint" type="fixed">
      <pose>0.14 0 -0.12 0 0 0</pose>
      <parent>base_link</parent>
      <child>front_caster</child>
    </joint>
    <joint name="rear_caster_joint" type="fixed">
      <pose>-0.14 0 -0.12 0 0 0</pose>
      <parent>base_link</parent>
      <child>rear_caster</child>
    </joint>

    <!-- ステップ3: 支柱つきカメラ(前方 +x を向く) -->
    <link name="camera_link">
      <pose>0.10 0 0.80 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="camera_mast_visual">
        <pose>0 0 -0.30 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>0.60</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
      <visual name="camera_body_visual">
        <geometry>
          <box>
            <size>0.04 0.06 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <sensor name="camera" type="camera">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>20</far>
          </clip>
        </camera>
        <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/follower_bot_new</namespace>
          </ros>
          <camera_name>camera</camera_name>
          <frame_name>camera_link</frame_name>
        </plugin>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed">
      <pose>0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>
  </model>
</sdf>

